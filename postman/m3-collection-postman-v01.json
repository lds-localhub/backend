{
  "info": {
    "_postman_id": "7f30e8ea-daf7-4e99-a263-b53b665f6e19",
    "name": "LocalHub API",
    "description": "Collection da API do LocalHub (Plano de Testes do backend v01, secção 12). Uma pasta por funcionalidade, com um pedido por endpoint.\n\nExecutar as pastas por ordem: os pedidos de cada pasta dependem dos anteriores (por exemplo, E02 guarda o token usado por E03 e E04).\n\nVariáveis: baseUrl (por defeito http://localhost:5041), password (palavra-passe fictícia das contas criadas pela collection), token (preenchido por E02), adminEmail (Administrador do conjunto inicial), adminPassword (vazia: indicada na execução, por exemplo com --env-var adminPassword=...) e as variáveis preenchidas pelos pedidos da F002 (accountEmail, accountId, accountToken, adminToken, adminId). Não contém segredos pessoais.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health check (200)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Devolve 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "F001 — Registo, autenticação e autorização",
      "description": "Endpoints E01 a E04 (API v02, secção 5).",
      "item": [
        {
          "name": "E01 — Registar conta (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana Costa\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"CLIENT\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "RF-F001-01. Cria um Cliente com um e-mail fictício novo (@localhub.test)."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// E-mail novo em cada execução, para o registo não colidir com execuções anteriores.",
                  "pm.collectionVariables.set(\"email\", `postman.${Date.now()}@localhub.test`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Devolve 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Location aponta para /api/users/me\", () => pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/api/users/me\"));",
                  "pm.test(\"Conta ativa com o papel pedido\", () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.email).to.eql(pm.collectionVariables.get(\"email\"));",
                  "    pm.expect(body.role).to.eql(\"CLIENT\");",
                  "    pm.expect(body.status).to.eql(\"ACTIVE\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "E01 — E-mail já registado, com maiúsculas (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana Costa\",\n  \"email\": \"{{emailUpper}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"PROVIDER\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "RF-F001-01, critério 2. Depende do pedido anterior."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"emailUpper\", pm.collectionVariables.get(\"email\").toUpperCase());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Devolve 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"Erro em Problem Details com type e instance\", () => {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.type).to.eql(\"https://tools.ietf.org/html/rfc9110#section-15.5.10\");",
                  "    pm.expect(body.instance).to.eql(\"/\" + pm.request.url.path.join(\"/\"));",
                  "});",
                  "pm.test(\"Erro no campo email\", () => pm.expect(pm.response.json().errors).to.have.property(\"email\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "E01 — Campos inválidos e papel ADMIN (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"email\": \"invalido\",\n  \"password\": \"abcdefgh\",\n  \"role\": \"ADMIN\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "RF-F001-01, critérios 3 e 4. «abcdefgh» não tem algarismos."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Devolve 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Erro em Problem Details com type e instance\", () => {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.type).to.eql(\"https://tools.ietf.org/html/rfc9110#section-15.5.1\");",
                  "    pm.expect(body.instance).to.eql(\"/\" + pm.request.url.path.join(\"/\"));",
                  "});",
                  "pm.test(\"Erro em cada campo\", () => {",
                  "    const errors = pm.response.json().errors;",
                  "    [\"name\", \"email\", \"password\", \"role\"].forEach(f => pm.expect(errors).to.have.property(f));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "E02 — Iniciar sessão (200, guarda o token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "RF-F001-02. Inicia sessão com a conta criada em E01 e guarda o token na variável token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Devolve 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Devolve token, expiresAt e user\", () => {",
                  "    pm.expect(body.token).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(body.expiresAt).to.be.a(\"string\");",
                  "    pm.expect(body.user.email).to.eql(pm.collectionVariables.get(\"email\"));",
                  "});",
                  "pm.test(\"Sessão de 8 horas, no máximo\", () => {",
                  "    const hours = (new Date(body.expiresAt) - Date.now()) / 3600000;",
                  "    pm.expect(hours).to.be.within(7.9, 8);",
                  "});",
                  "// Guarda o token para os pedidos protegidos seguintes.",
                  "pm.collectionVariables.set(\"token\", body.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "E02 — Palavra-passe errada (401 credenciais-invalidas)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"errada123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "RF-F001-02. A mesma mensagem é usada para um e-mail inexistente."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Devolve 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Erro em Problem Details com type e instance\", () => {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.type).to.eql(\"https://localhub.local/erros/credenciais-invalidas\");",
                  "    pm.expect(body.instance).to.eql(\"/\" + pm.request.url.path.join(\"/\"));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "E04 — Consultar o utilizador autenticado (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "me"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "description": "RF-F001-03. Usa o token guardado por E02."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Devolve 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Devolve o utilizador da sessão\", () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.email).to.eql(pm.collectionVariables.get(\"email\"));",
                  "    pm.expect(body.role).to.eql(\"CLIENT\");",
                  "    pm.expect(body.latitude).to.be.null;",
                  "    pm.expect(body.professionalProfileId).to.be.null;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "E04 — Sem token (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "me"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "RF-F001-03, RNF-03."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Devolve 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Erro em Problem Details com type e instance\", () => {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.type).to.eql(\"https://tools.ietf.org/html/rfc9110#section-15.5.2\");",
                  "    pm.expect(body.instance).to.eql(\"/\" + pm.request.url.path.join(\"/\"));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "E03 — Terminar sessão (204)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "description": "RF-F001-04. Revoga a sessão do token guardado."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Devolve 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "E04 — Token depois de terminar sessão (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "me"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "description": "RF-F001-04, RNF-02. O token revogado deixa de ser aceite."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Devolve 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Erro em Problem Details com type e instance\", () => {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.type).to.eql(\"https://tools.ietf.org/html/rfc9110#section-15.5.2\");",
                  "    pm.expect(body.instance).to.eql(\"/\" + pm.request.url.path.join(\"/\"));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "F002 — Gestão de contas",
      "description": "Endpoints E05 a E07 (API v02, secção 8). Precisa da variável adminPassword, indicada na execução.",
      "item": [
        {
          "name": "E01 — Registar o Prestador usado na gestão de contas (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Gestão de Contas\",\n  \"email\": \"{{accountEmail}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"PROVIDER\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Cria um Prestador com um e-mail fictício novo e guarda o userId em accountId."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"accountEmail\", `postman.contas.${Date.now()}@localhub.test`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Devolve 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"accountId\", body.userId);"
                ]
              }
            }
          ]
        },
        {
          "name": "E02 — Iniciar sessão como Prestador (200, guarda accountToken)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{accountEmail}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Sessão do Prestador, usada para verificar o 403 e a revogação da sessão na desativação."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Devolve 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"accountToken\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "E05 — Pedido de um Prestador (403)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/accounts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "accounts"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accountToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "RF-F002-01, RNF-03. A gestão de contas é reservada ao Administrador."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Devolve 403\", () => pm.response.to.have.status(403));",
                  "pm.test(\"Erro em Problem Details com type e instance\", () => {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.type).to.eql(\"https://tools.ietf.org/html/rfc9110#section-15.5.4\");",
                  "    pm.expect(body.instance).to.eql(\"/\" + pm.request.url.path.join(\"/\"));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "E02 — Iniciar sessão como Administrador (200, guarda adminToken)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Administrador do conjunto inicial. A palavra-passe é Seed:DefaultPassword do appsettings.Development.json (ou a dos scripts da I038) e é indicada na execução, na variável adminPassword; não é guardada na collection."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A palavra-passe do Administrador é indicada na execução (por exemplo, --env-var adminPassword=...).",
                  "pm.test(\"Variável adminPassword indicada\", () => pm.expect(pm.variables.get(\"adminPassword\")).to.not.be.empty);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Devolve 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Sessão de Administrador\", () => pm.expect(body.user.role).to.eql(\"ADMIN\"));",
                  "pm.collectionVariables.set(\"adminToken\", body.token);",
                  "pm.collectionVariables.set(\"adminId\", body.user.userId);"
                ]
              }
            }
          ]
        },
        {
          "name": "E05 — Listar contas (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/accounts?page=1&pageSize=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "accounts"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "20"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "RF-F002-01. Lista paginada das contas de Clientes e Prestadores, ordenada pelo nome."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Devolve 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Resposta paginada\", () => {",
                  "    pm.expect(body.page).to.eql(1);",
                  "    pm.expect(body.pageSize).to.eql(20);",
                  "    pm.expect(body.total).to.be.a(\"number\");",
